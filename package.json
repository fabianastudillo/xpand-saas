{
  "name": "xpand-saas",
  "version": "0.0.0",
  "private": true,
  "description": "Interfaz nueva de XPAND (M0): monorepo pnpm con paquetes y aplicaciones.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @xpand/web dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run && pnpm test:scripts && pnpm --filter @xpand/api gen:check",
    "e2e": "pnpm --filter @xpand/ide-spa e2e",
    "build": "pnpm -r --if-present run build",
    "test:scripts": "bash scripts/package-dist.test.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
