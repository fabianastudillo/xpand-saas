{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xpand.local/contracts/api/red.schema.json",
  "title": "Red",
  "description": "Respuesta de GET /api/red?motor=&sistema=&tec=. Solo se exigen los campos de la ficha que lee la interfaz de M0; ver contracts/api/README.md.",
  "type": "object",
  "required": ["barras", "ac_existentes", "ac_candidatos"],
  "additionalProperties": true,
  "properties": {
    "barras": {
      "type": "array",
      "items": { "$ref": "#/definitions/barra" }
    },
    "ac_existentes": {
      "type": "array",
      "items": { "$ref": "#/definitions/lineaExistente" }
    },
    "ac_candidatos": {
      "type": "array",
      "items": { "$ref": "#/definitions/lineaCandidata" }
    }
  },
  "definitions": {
    "barra": {
      "type": "object",
      "required": ["id", "nombre", "kv", "pd", "qd", "vmin", "vmax"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "nombre": { "type": "string" },
        "kv": { "type": "number" },
        "pd": { "type": "number" },
        "qd": { "type": "number" },
        "vmin": { "type": "number" },
        "vmax": { "type": "number" }
      }
    },
    "lineaExistente": {
      "type": "object",
      "required": ["id", "de", "a", "r", "x", "s"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "de": { "type": "string", "minLength": 1 },
        "a": { "type": "string", "minLength": 1 },
        "r": { "type": "number" },
        "x": { "type": "number" },
        "s": { "type": "number" }
      }
    },
    "lineaCandidata": {
      "type": "object",
      "required": ["id", "de", "a", "r", "x", "s", "costo", "nmax"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "de": { "type": "string", "minLength": 1 },
        "a": { "type": "string", "minLength": 1 },
        "r": { "type": "number" },
        "x": { "type": "number" },
        "s": { "type": "number" },
        "costo": { "type": "number", "minimum": 0 },
        "nmax": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
