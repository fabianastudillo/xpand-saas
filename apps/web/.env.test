# Entorno de las pruebas Playwright de apps/web (sin secretos reales: todo es local y regenerable).
# NEXTAUTH_SECRET y la contraseña de Postgres se generaron para este repositorio; no son las de la plantilla.
NEXTAUTH_SECRET=ZpBAddlsX3SJzsRDlpEkGvgeAXlW448t0vkm6q45d2k=
NODE_ENV=test
# URL base de Auth.js: la misma en la que escucha la app (si no, los enlaces mágicos salen con localhost).
NEXTAUTH_URL=http://127.0.0.1:8870

# Proveedores de entrada: vacíos (Google apagado).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correo del primer administrador (lo crea scripts/create-admin-user-script.ts); las pruebas siembran los suyos.
ADMIN_EMAIL=

# Base de datos de prueba: la levanta `pnpm test:db:start` (docker-compose.test.yml) en 127.0.0.1:5433.
DATABASE_URL="postgresql://xpand_test:19c89d09846f4e5e0da75cda@127.0.0.1:5433/xpand_test?schema=public"
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=xpand_test
POSTGRES_PASSWORD=19c89d09846f4e5e0da75cda
POSTGRES_DB=xpand_test

# Correo saliente: el servidor SMTP de prueba que levanta tests/global-setup.ts (smtp-tester) en el 4025.
MAILGUN_API_KEY=
RESEND_API_KEY=
EMAIL_SERVER=smtp://127.0.0.1:4025

# Pagos: apagados (sin claves).
