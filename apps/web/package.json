{
  "name": "@xpand/web",
  "version": "0.1.0",
  "private": true,
  "description": "App Next de la plataforma XPAND: plantilla open-micro-saas (saas-plantilla 43e65a1) con público, cuentas y administración.",
  "scripts": {
    "dev": "node scripts/arranque.mjs dev",
    "build": "prisma generate && next build",
    "start": "node scripts/arranque.mjs start",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "format": "prettier --write --ignore-path .gitignore .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test:db:start": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:stop": "docker compose -f docker-compose.test.yml down",
    "test:db:prepare": "dotenv -e .env.test -- prisma migrate deploy",
    "test:db:migrate": "dotenv -e .env.test -- prisma migrate dev",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose down",
    "db:migrate:dev": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "script:create:admin": "dotenv -- tsx ./scripts/create-admin-user-script.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seeds/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@next/env": "^15.5.29",
    "@next/third-parties": "^15.5.29",
    "@prisma/client": "^5.7.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@xpand/api": "workspace:*",
    "@xpand/casos": "workspace:*",
    "@xpand/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "crisp-sdk-web": "^1.0.21",
    "form-data": "^4.0.0",
    "lucide-react": "^1.70.0",
    "mailgun.js": "^10.0.0",
    "next": "^15.5.29",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "resend": "^6.37.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "stripe": "^14.13.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.3.0",
    "postcss": "^8",
    "prettier": "^3.1.1",
    "prisma": "^5.7.1",
    "smtp-tester": "^2.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.7.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
