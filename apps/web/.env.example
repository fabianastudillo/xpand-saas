# Copia este fichero a .env (git lo ignora) y rellena lo que uses. Todo tercero (Google, Stripe, correo externo)
# queda apagado mientras su clave esté vacía: la app arranca, ninguna página falla y no se habla con ellos.

# --- Arranque (scripts/arranque.mjs) ---
# El script lee este .env y .env.local (los mismos que Next) antes de decidir; lo que venga del shell manda.
# Next escucha solo en 127.0.0.1. Para escuchar en otra dirección hay que pedirlo expresamente, y con AUTH_URL:
#   HOST=0.0.0.0 XPAND_PERMITIR_RED=1 AUTH_URL=http://<host>:8870 pnpm dev
XPAND_WEB_PORT=8870
# Etiqueta «Sesión local» de /api/sesion (`local`). Solo rotula: ninguna autorización depende de ella. arranque.mjs
# la pone a 1 cuando Next escucha en 127.0.0.1 y no está definida; sin arranque.mjs (server.js standalone) vale 0.
# Detrás de un proxy inverso en esta misma máquina todo llega por 127.0.0.1: ahí déjala a 0.
# XPAND_MODO_LOCAL=0

# --- Auth.js ---
# Secreto de firma de las sesiones: `openssl rand -base64 32`.
NEXTAUTH_SECRET=
# URL pública de la app. Obligatoria en producción y fuera del bucle también en `pnpm dev` (sin ella el arranque
# termina con código 64): Auth.js monta los enlaces
# de entrada sobre ella y no sobre la cabecera Host de la petición (src/libs/auth/host-confianza.ts). En local,
# Next muestra el bucle como `localhost` en el navegador aunque escuche en 127.0.0.1.
AUTH_URL=http://127.0.0.1:8870
# NODE_ENV no se pone aquí: lo fija el script de arranque (development para `pnpm dev`, production para `pnpm start`).

# Entrada con Google (opcional). Sin las dos claves el botón no se ofrece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correo del primer administrador: lo crea `pnpm script:create:admin` (scripts/create-admin-user-script.ts).
ADMIN_EMAIL=

# --- Base de datos (Postgres) ---
# `pnpm db:start` levanta docker-compose.yml con estos valores; DATABASE_URL es la que usa Prisma.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=6500
POSTGRES_USER=xpand
# Elige una contraseña (p. ej. `openssl rand -hex 16`) y ponla también en DATABASE_URL; docker compose no arranca sin ella.
POSTGRES_PASSWORD=
POSTGRES_DB=xpand
DATABASE_URL="postgresql://xpand:<POSTGRES_PASSWORD>@127.0.0.1:6500/xpand?schema=public"

# --- Correo de entrada (enlaces mágicos) ---
# Servidor SMTP (smtp://usuario:clave@host:puerto). Vacío: la entrada por correo no se ofrece.
EMAIL_SERVER=
# Remitente que ese servidor permite.
EMAIL_FROM="XPAND <no-reply@localhost>"
# Ayudantes alternativos de src/libs/email (no se usan por defecto).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
RESEND_API_KEY=

# --- Pagos (Stripe, opcional) ---
# Con las dos claves vacías los planes se muestran pero no se pueden contratar y no se crea cliente en Stripe.
# https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_ENDPOINT_SECRET=
