# Dependencias y salidas de build
node_modules/
dist/
coverage/
*.tsbuildinfo
playwright-report/
test-results/

# Ficheros locales de herramientas (no se versionan)
.claude/
.playwright-mcp/

# Secretos y entorno local
.env
.env.*
!.env.example

# Entorno de pruebas de apps/web: valores locales regenerados, sin secretos reales
!.env.test

# Almacen de casos: vive fuera del repo; nunca se versiona (salvo el de prueba, escrito a mano)
almacen/
# Excepcion: solo los casos de prueba de packages/casos, uno por uno; una carpeta nueva ahi queda ignorada
!packages/casos/test/almacen/
packages/casos/test/almacen/*/*
!packages/casos/test/almacen/jump_misocp/tnep_garver6/
!packages/casos/test/almacen/jump_misocp/sintetico_interno/
!packages/casos/test/almacen/jump_misocp/tnep_truncado/
!packages/casos/test/almacen/jump_misocp/tnep_invalido/
!packages/casos/test/almacen/fp_dc/tnep_garver6/
!contracts/almacen/
