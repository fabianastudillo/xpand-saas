# ============================================================================
#  garver6/base.dat  ---  sistema Garver 6 barras (TNEP puro, sin GEP)
#  Carga y generacion = Garver CLASICO (factible con generacion existente:
#  bus 6 = gen barato 610 MW AISLADO en la topologia base -> el TNEP debe
#  conectarlo). Corredores/costos AC-DC = auditados MISO MTEP24 (ver docs).
#  Unidades: pu sobre Sbase=100. Pd/Qd MW,MVAr /100. Ratings MVA /100.
# ============================================================================
param Sbase := 100;
param refbus := 1;

# 08/10/2026 (GUI Laptop): ESCALARES del benchmark_release/garver6_acdc_facts.dat (MD5 91ae5c87) que faltaban. La
# igualacion del 07/10 comparo solo tablas: sin ellos el motor usaba load_scale 1,0 (760 MW, no los 1064 MW del articulo),
# OPF_SCALE 1 y angulo de rama 90 grados. Detectado por la TR (BKS 1636,6 < cota publicada 2314,6).
param CRF := 1; param OPF_SCALE := 0; param load_scale := 1.40;
param tan_amax := 0.8391; param theta_max_rad := 0.6981;

# bus:  type  Pd     Qd     Gsh Bsh  Vmin  Vmax
param: BUS: bus_type Pd Qd Gsh Bsh Vmin Vmax :=
  1   3   0.80  0.24  0  0  0.95 1.05
  2   1   2.40  0.72  0  0  0.95 1.05
  3   2   0.40  0.12  0  0  0.95 1.05
  4   1   1.60  0.48  0  0  0.95 1.05
  5   1   2.40  0.72  0  0  0.95 1.05
  6   2   0.00  0.00  0  0  0.95 1.05 ;

# generacion existente (audited .m mpc.gen buses 1,3,6). Costo operativo 0
# (Garver clasico = TNEP de inversion pura); c2/c1/c0 quedan disponibles.
param: GEN: gen_bus Pgmin Pgmax Qgmin Qgmax cg2 cg1 cg0 :=
  G1   1   0   1.60  -0.10  0.48   0  0  0
  G3   3   0   3.70  -0.10  1.01   0  0  0
  G6   6   0   6.10  -0.10  1.83   0  0  0 ;

# lineas AC existentes (Garver clasico, status=1). rate MVA/100. bch=0.
param: ELINE: el_f el_t el_r el_x el_bch el_S :=
  E12  1 2   0.04  0.40  0  1.20
  E14  1 4   0.06  0.60  0  1.00
  E15  1 5   0.02  0.20  0  1.20
  E23  2 3   0.02  0.20  0  1.20
  E24  2 4   0.04  0.40  0  1.20
  E35  3 5   0.02  0.20  0  1.20 ;
